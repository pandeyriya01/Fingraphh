# FinGraph Environment Variables

# Environment mode: development / production / local_test
ENVIRONMENT=development
LOG_LEVEL=INFO

# Neo4j Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=fingraph_secret_password
NEO4J_DATABASE=neo4j

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_TRANSACTIONS=transactions.raw
KAFKA_TOPIC_PROCESSED_TRANSACTIONS=transactions.processed
KAFKA_TOPIC_FRAUD_ALERTS=alerts.fraud
KAFKA_CONSUMER_GROUP=fingraph-analytics-group

# Flink Settings
FLINK_JOBMANAGER_HOST=localhost
FLINK_JOBMANAGER_PORT=8081

# Alert Thresholds & Integration
RISK_SCORE_ALERT_THRESHOLD=75.0
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/MOCK/WEBHOOK/URL
EMAIL_ALERT_RECIPIENT=risk-analyst@bank.com
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=mock_user
SMTP_PASSWORD=mock_password

# Dashboard Settings
DASHBOARD_PORT=8501
DASHBOARD_HOST=0.0.0.0
